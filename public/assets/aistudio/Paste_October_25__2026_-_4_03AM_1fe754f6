  // Dynamic Password Validation and Strength Meter
  const passwordInput = document.getElementById('password');
  const toggleBtn = document.getElementById('togglePassword');
  const eyeIcon = document.getElementById('eyeIcon');
  const strengthText = document.getElementById('strengthText');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  const bar4 = document.getElementById('bar4');
  const lenIcon = document.getElementById('lenIcon');
  const numIcon = document.getElementById('numIcon');
  const symIcon = document.getElementById('symIcon');

  toggleBtn.addEventListener('click', () => {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      eyeIcon.textContent = 'visibility_off';
    } else {
      passwordInput.type = 'password';
      eyeIcon.textContent = 'visibility';
    }
  });

  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;
    const hasMinLen = val.length >= 12;
    const hasNum = /\d/.test(val);
    const hasSym = /[^A-Za-z0-9]/.test(val);
    const hasUpperLower = /[a-z]/.test(val) && /[A-Z]/.test(val);

    // Update Requirement Icons
    lenIcon.textContent = hasMinLen ? 'check_circle' : 'radio_button_unchecked';
    lenIcon.className = `material-symbols-outlined text-[14px] ${hasMinLen ? 'text-on-tertiary-container' : 'text-outline'}`;
    
    numIcon.textContent = hasNum ? 'check_circle' : 'radio_button_unchecked';
    numIcon.className = `material-symbols-outlined text-[14px] ${hasNum ? 'text-on-tertiary-container' : 'text-outline'}`;
    
    symIcon.textContent = hasSym ? 'check_circle' : 'radio_button_unchecked';
    symIcon.className = `material-symbols-outlined text-[14px] ${hasSym ? 'text-on-tertiary-container' : 'text-outline'}`;

    // Calculate score
    let score = 0;
    if (val.length > 0) score++;
    if (hasMinLen) score++;
    if (hasNum && hasSym) score++;
    if (hasMinLen && hasNum && hasSym && hasUpperLower) score++;

    // Reset indicator bars
    [bar1, bar2, bar3, bar4].forEach(bar => {
      bar.className = 'h-full bg-surface-container-high rounded-full transition-colors duration-300';
    });

    if (score === 0) {
      strengthText.textContent = 'Min. 12 chars';
      strengthText.className = 'font-label-sm text-label-sm text-on-surface-variant';
    } else if (score === 1) {
      bar1.className = 'h-full bg-error rounded-full';
      strengthText.textContent = 'Weak';
      strengthText.className = 'font-label-sm text-label-sm text-error font-semibold';
    } else if (score === 2) {
      bar1.className = 'h-full bg-amber-500 rounded-full';
      bar2.className = 'h-full bg-amber-500 rounded-full';
      strengthText.textContent = 'Fair';
      strengthText.className = 'font-label-sm text-label-sm text-amber-600 font-semibold';
    } else if (score === 3) {
      bar1.className = 'h-full bg-secondary-container rounded-full';
      bar2.className = 'h-full bg-secondary-container rounded-full';
      bar3.className = 'h-full bg-secondary-container rounded-full';
      strengthText.textContent = 'Strong';
      strengthText.className = 'font-label-sm text-label-sm text-secondary-container font-semibold';
    } else if (score === 4) {
      bar1.className = 'h-full bg-on-tertiary-container rounded-full';
      bar2.className = 'h-full bg-on-tertiary-container rounded-full';
      bar3.className = 'h-full bg-on-tertiary-container rounded-full';
      bar4.className = 'h-full bg-on-tertiary-container rounded-full';
      strengthText.textContent = 'Enterprise Grade';
      strengthText.className = 'font-label-sm text-label-sm text-on-tertiary-container font-bold';
    }
  });
